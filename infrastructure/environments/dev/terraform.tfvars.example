# Task B4. Copy to terraform.tfvars and adjust if needed. terraform.tfvars is
# gitignored and must never be committed; this .example file is committed.
# Every value below except account_id is also the variable's default.
# account_id has no default: use the same account ID that
# scripts/bootstrap-state.sh put in backend.tf's bucket name.

account_id              = "YOUR_ACCOUNT_ID"
project                 = "northstar"
environment             = "dev"
aws_region              = "us-east-1"
vpc_cidr                = "10.0.0.0/16"
public_subnet_cidr      = "10.0.100.0/24"
availability_zone       = "us-east-1a"
sagemaker_instance_type = "ml.t3.medium"
