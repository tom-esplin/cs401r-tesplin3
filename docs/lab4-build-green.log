      --pipeline-execution-arn $EXECUTION_ARN \
      --query "PipelineExecutionSteps[].{Step:StepName,Status:StepStatus,Reason:FailureReason}" \
      --output table || true
    exit 1
  fi

  ELAPSED=$((ELAPSED + SLEEP_INTERVAL))
  if [ $ELAPSED -ge $MAX_WAIT ]; then
    echo "Pipeline timed out after ${MAX_WAIT}s"
    exit 1
  fi

  sleep $SLEEP_INTERVAL
done

